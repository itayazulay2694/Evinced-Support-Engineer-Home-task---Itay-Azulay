{
  "name": "playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Evinced Playwright JS SDK home exercise on a11y-audits.com",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:scale": "playwright test --project=scale-example",
    "test:all": "playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@evinced/js-playwright-sdk": "^2.52.1",
    "dotenv": "^16.4.7"
  }
}
